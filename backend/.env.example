# Optional - copy to backend/.env (never commit it). Defaults already work with a fresh XAMPP.
# Quote values that contain special characters, e.g. DB_PASS="p@ss;word"
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASS=
# DB_NAME=shopease

# Browser origin(s) allowed to call the API cross-origin, comma-separated.
# Not needed when the frontend uses the Vite proxy / same origin.
# ALLOWED_ORIGINS=http://localhost:5173
